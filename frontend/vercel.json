{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://kigali-eco-park.onrender.com/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://kigali-eco-park.onrender.com/media/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://kigali-eco-park.onrender.com/uploads/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
